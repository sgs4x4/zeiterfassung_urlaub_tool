# next-auth@4.24.15 pinnt @auth/core als optionalen Peer exakt auf 0.34.3, welches
# wiederum nodemailer@^7 als optionalen Peer erwartet. Wir halten nodemailer bewusst auf
# ^9.0.5 (Sicherheitsfix, siehe npm audit), da EmailProvider/Adapter hier nicht genutzt
# werden (siehe SECURITY NOTE in lib/auth.ts). Ohne legacy-peer-deps bricht npm install
# an diesem – für uns irrelevanten – optionalen Peer-Konflikt hart ab.
legacy-peer-deps=true
